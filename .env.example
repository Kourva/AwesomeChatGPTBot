# CF gateway to proxy the bot so it runs in restricted countries
# see the https://github.com/Kourva/cloudflare-workers/#-tba for the worker
PROXY_URL=https://tba.xxxxx.workers.dev
PROXY_SECRET=

# Bot token from @BotFatehr
BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database
DATABASE_PATH=src/database/

# Administration
ADMIN_ID=xxxxxxxxxx

# Optional
# Used only when Telegram sends no supported language_code
DEFAULT_LANGUAGE=en
HISTORY_LIMIT=20
TTS_VOICE=Brian
# streamelements (default) or voicepods
TTS_PROVIDER=streamelements

# Optional provider keys, the bot skips providers without a key
DEEPINFRA_API_KEY=
OPENROUTER_API_KEY=

# Vision models used for uploaded images (only when the key is set)
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free
DEEPINFRA_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
